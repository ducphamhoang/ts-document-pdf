{
  "name": "document-to-pdf-service",
  "version": "1.0.0",
  "description": "A service to convert office documents to PDF",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src/**/* tests/**/*",
    "format": "prettier --write src/**/* tests/**/*"
  },
  "keywords": [
    "pdf",
    "document",
    "conversion",
    "office"
  ],
  "author": "Document to PDF Service",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.25.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exponential-backoff": "^3.1.3",
    "express": "^4.21.2",
    "helmet": "^7.2.0",
    "iso-639-1": "^3.1.5",
    "multer": "^1.4.5-lts.1",
    "reflect-metadata": "^0.2.2",
    "uuid": "^13.0.0",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/file-type": "^10.6.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.20",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "file-type": "^21.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
